# Copy to .env.local and fill in. Names only here — never commit real values.

# ── Follow Up Boss ────────────────────────────────────────────────
# Required by the lead routes (/api/leads, /api/seller-leads,
# /api/showing-requests, /api/property-analysis, /api/value-lead).
# Sent as the Basic-auth username with an empty password. Server-side only:
# never prefix it with NEXT_PUBLIC_.
FUB_API_KEY=

# Seller postcard page (/value). The registered-system key Follow Up Boss
# issues for the "DYNAH" X-System name. Optional; sent as X-System-Key only
# when set.
FUB_SYSTEM_KEY=

# /api/value-lead test mode. DRY_RUN=true returns the Follow Up Boss payload as
# JSON instead of sending it (a request header `x-dry-run: true` does the same).
# Local/preview only: it is ignored when VERCEL_ENV=production. Leave unset in
# every production environment.
# DRY_RUN=

# ── Florida Sun & Shade Analyzer (/sun-shade) ─────────────────────
# Both optional — the analyzer runs with an empty environment.

# Strongly recommended. Goes into the User-Agent sent to Overpass and
# Nominatim. Both services explicitly ask for a real contact address, and
# an anonymous client is the first one they rate-limit: overpass-api.de
# answers 406 and overpass.kumi.systems answers 429 to a request with no
# meaningful User-Agent, which shows up in the app as zero buildings and
# no shadows.
SUNSHADE_CONTACT_EMAIL=

# Forces a geocoding provider instead of the default chain
# (census, then nominatim). Accepts: census | nominatim
SUNSHADE_GEOCODER=
