# ── Follow Up Boss ────────────────────────────────────────────────
# Required by the lead routes (/api/leads, /api/seller-leads,
# /api/showing-requests, /api/property-analysis).
FUB_API_KEY=

# ── Florida Sun & Shade Analyzer (/sun-shade) ─────────────────────
# Both optional — the analyzer runs with an empty environment.

# Strongly recommended. Goes into the User-Agent sent to Overpass and
# Nominatim. Both services explicitly ask for a real contact address, and
# an anonymous client is the first one they rate-limit: overpass-api.de
# answers 406 and overpass.kumi.systems answers 429 to a request with no
# meaningful User-Agent, which shows up in the app as zero buildings and
# no shadows.
SUNSHADE_CONTACT_EMAIL=

# Forces a geocoding provider instead of the default chain
# (census, then nominatim). Accepts: census | nominatim
SUNSHADE_GEOCODER=
